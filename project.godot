; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Serpentina Racer"
config/description="Corrida arcade 3D low-poly por uma estrada sinuosa de montanha."
run/main_scene="res://Scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://Scripts/Core/GameManager.cs"
SaveSystem="*res://Scripts/Core/SaveSystem.cs"
AudioManager="*res://Scripts/Audio/AudioManager.cs"

[dotnet]

project/assembly_name="SerpentinaRacer"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

